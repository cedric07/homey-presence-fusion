{
  "name": {
    "en": "Presence overview",
    "fr": "Vue présence"
  },
  "height": 200,
  "settings": [
    {
      "id": "show_transition",
      "type": "checkbox",
      "value": true,
      "title": {
        "en": "Show arrival / departure",
        "fr": "Afficher Arrivée / Départ"
      }
    },
    {
      "id": "show_sources",
      "type": "checkbox",
      "value": true,
      "title": {
        "en": "Show sources",
        "fr": "Afficher les sources"
      }
    },
    {
      "id": "show_force",
      "type": "checkbox",
      "value": true,
      "title": {
        "en": "Show forced presence controls",
        "fr": "Afficher les commandes de présence forcée"
      }
    }
  ],
  "api": {
    "getStatus": {
      "method": "GET",
      "path": "/"
    },
    "setForcedPresence": {
      "method": "POST",
      "path": "/forced"
    }
  }
}
