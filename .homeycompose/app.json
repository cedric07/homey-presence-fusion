{
  "id": "com.cedric07.presencefusion",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Presence Fusion",
    "fr": "Présence Fusion"
  },
  "description": {
    "en": "Combine several devices into Homey’s native user presence — Wi‑Fi, Beacon, and more.",
    "fr": "Combinez plusieurs appareils pour piloter la présence native Homey — Wi‑Fi, Beacon, et plus."
  },
  "category": [
    "tools"
  ],
  "brandColor": "#09225F",
  "permissions": [
    "homey:manager:api"
  ],
  "images": {
    "small": "/assets/images/small.jpg",
    "large": "/assets/images/large.jpg",
    "xlarge": "/assets/images/xlarge.jpg"
  },
  "author": {
    "name": "Cédric Andrietti",
    "email": "cedric.andrietti@gmail.com"
  },
  "support": "https://github.com/cedric07/homey-presence-fusion/issues",
  "source": "https://github.com/cedric07/homey-presence-fusion",
  "bugs": {
    "url": "https://github.com/cedric07/homey-presence-fusion/issues"
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "CedricAndrietti"
      }
    }
  },
  "tags": {
    "en": [
      "presence",
      "fusion",
      "wifi",
      "beacon",
      "bluetooth",
      "smart presence",
      "home",
      "away"
    ],
    "fr": [
      "présence",
      "fusion",
      "wifi",
      "beacon",
      "bluetooth",
      "smart presence",
      "maison",
      "absent"
    ]
  },
  "api": {
    "getBootstrap": {
      "method": "GET",
      "path": "/bootstrap"
    },
    "setUserEnabled": {
      "method": "POST",
      "path": "/users/enabled"
    },
    "setUserRules": {
      "method": "POST",
      "path": "/users/rules"
    },
    "getLinkCandidates": {
      "method": "GET",
      "path": "/linking/candidates"
    },
    "linkDeviceSource": {
      "method": "POST",
      "path": "/linking"
    },
    "unlinkDeviceSource": {
      "method": "POST",
      "path": "/linking/unlink"
    },
    "getDeviceCapabilities": {
      "method": "GET",
      "path": "/linking/capabilities"
    },
    "updateLinkedSource": {
      "method": "POST",
      "path": "/linking/update"
    },
    "saveOwnerApiKey": {
      "method": "POST",
      "path": "/owner-api-key"
    }
  }
}
