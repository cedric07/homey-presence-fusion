{
  "id": "com.cedric07.presencefusion",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Presence Fusion",
    "fr": "Présence Fusion"
  },
  "description": {
    "en": "Combine several devices into Homey’s native user presence — Wi‑Fi, Beacon, and more.",
    "fr": "Combinez plusieurs appareils pour piloter la présence native Homey — Wi‑Fi, Beacon, et plus."
  },
  "category": [
    "tools"
  ],
  "brandColor": "#2F80ED",
  "permissions": [
    "homey:manager:api"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Cédric Andrietti",
    "email": "cedric.andrietti@gmail.com"
  },
  "api": {
    "getBootstrap": {
      "method": "GET",
      "path": "/bootstrap"
    },
    "setUserEnabled": {
      "method": "POST",
      "path": "/users/enabled"
    },
    "setUserRules": {
      "method": "POST",
      "path": "/users/rules"
    },
    "getLinkCandidates": {
      "method": "GET",
      "path": "/linking/candidates"
    },
    "linkDeviceSource": {
      "method": "POST",
      "path": "/linking"
    },
    "unlinkDeviceSource": {
      "method": "POST",
      "path": "/linking/unlink"
    },
    "getDeviceCapabilities": {
      "method": "GET",
      "path": "/linking/capabilities"
    },
    "updateLinkedSource": {
      "method": "POST",
      "path": "/linking/update"
    }
  }
}
